rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Helpers ---
    
    function isValidTournament(data) {
      return data.keys().hasAll(['name', 'createdAt', 'ownerId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.createdAt is number &&
             data.ownerId == request.auth.uid;
    }

    function isValidTeam(data) {
      return data.keys().hasAll(['name', 'ownerId', 'tournamentId']) &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.tournamentId is string &&
             data.ownerId == request.auth.uid &&
             (data.get('shortName', '') is string) &&
             (data.get('color', '') is string);
    }

    function isValidPlayer(data) {
      return data.keys().hasAll(['teamIds', 'name', 'ownerId']) &&
             data.teamIds is list &&
             data.name is string && data.name.size() > 0 && data.name.size() <= 100 &&
             data.ownerId == request.auth.uid &&
             (data.get('number', 0) is number);
    }

    function isValidMatch(data) {
      return data.keys().hasAll(['tournamentName', 'homeTeam', 'awayTeam', 'homeScore', 'awayScore', 'status', 'halfDuration', 'ownerId']) &&
             data.tournamentName is string && data.tournamentName.size() <= 100 &&
             (data.get('groupName', '') is string) &&
             data.homeTeam is map &&
             data.awayTeam is map &&
             data.homeScore is number && data.homeScore >= 0 &&
             data.awayScore is number && data.awayScore >= 0 &&
             data.status is string && data.status.size() <= 50 &&
             data.halfDuration is number && data.halfDuration >= 1 &&
             (data.get('elapsedSeconds', 0) is number) &&
             (data.get('startTime', 0) is number) &&
             (data.get('statusUpdatedAt', 0) is number) &&
             (data.get('isHidden', false) is bool) &&
             (data.get('maxSquadSize', 17) is number) &&
             (data.get('notes', '') is string) &&
             data.ownerId == request.auth.uid;
    }

    function isValidMatchEvent(data) {
      return data.keys().hasAll(['matchId', 'type', 'minute', 'timestamp']) &&
             data.matchId is string && data.matchId.size() <= 128 &&
             data.type is string && data.type.size() <= 50 &&
             data.minute is number && data.minute >= 0 &&
             data.timestamp is number &&
             (data.get('teamId', '') is string) &&
             (data.get('playerId', '') is string) &&
             (data.get('assistPlayerId', '') is string);
    }


    // --- Paths ---
    
    match /settings/{docId} {
      allow read: if true;
      allow write: if isSignedIn() && request.auth.token.email == 'mikewilken@gmail.com';
    }

    match /tournaments/{tournamentId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(tournamentId) && isValidTournament(incoming());
      allow update: if isSignedIn() && (
                      (existing().ownerId == request.auth.uid && isValidTournament(incoming())) ||
                      (request.auth.token.email == 'mikewilken@gmail.com')
                    );
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || request.auth.token.email == 'mikewilken@gmail.com');
    }

    match /teams/{teamId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(teamId) && isValidTeam(incoming());
      allow update: if isSignedIn() && (
                      (existing().ownerId == request.auth.uid && isValidTeam(incoming())) ||
                      (request.auth.token.email == 'mikewilken@gmail.com')
                    );
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || request.auth.token.email == 'mikewilken@gmail.com');
    }

    match /players/{playerId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(playerId) && isValidPlayer(incoming());
      allow update: if isSignedIn() && (
                      (existing().ownerId == request.auth.uid && isValidPlayer(incoming())) ||
                      (request.auth.token.email == 'mikewilken@gmail.com')
                    );
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || request.auth.token.email == 'mikewilken@gmail.com');
    }

    match /matches/{matchId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidId(matchId) && isValidMatch(incoming());
      allow update: if isSignedIn() && (existing().ownerId == request.auth.uid || request.auth.token.email == 'mikewilken@gmail.com');
      allow delete: if isSignedIn() && (existing().ownerId == request.auth.uid || request.auth.token.email == 'mikewilken@gmail.com');

      match /events/{eventId} {
        allow read: if true;
        allow write: if isSignedIn();
      }
    }
  }
}
